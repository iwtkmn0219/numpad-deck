{
  "name": {
    "ko": "Zoom 회의",
    "en": "Zoom meeting"
  },
  "description": {
    "ko": "Zoom 기본 단축키: 마이크·카메라·화면 공유·손 들기. Zoom 창이 앞에 있을 때 동작해요.",
    "en": "Zoom default shortcuts: mic, camera, share, raise hand. Works while Zoom is in front."
  },
  "buttons": {
    "7": {
      "label": {
        "ko": "마이크",
        "en": "Mic"
      },
      "icon": "mic",
      "action": {
        "type": "hotkey",
        "keys": [
          "Alt",
          "A"
        ]
      }
    },
    "8": {
      "label": {
        "ko": "카메라",
        "en": "Camera"
      },
      "icon": "video",
      "action": {
        "type": "hotkey",
        "keys": [
          "Alt",
          "V"
        ]
      }
    },
    "9": {
      "label": {
        "ko": "화면 공유",
        "en": "Share"
      },
      "icon": "screen-share",
      "action": {
        "type": "hotkey",
        "keys": [
          "Alt",
          "S"
        ]
      }
    },
    "+": {
      "label": {
        "ko": "손 들기",
        "en": "Raise hand"
      },
      "icon": "hand",
      "action": {
        "type": "hotkey",
        "keys": [
          "Alt",
          "Y"
        ]
      }
    },
    "4": {
      "label": {
        "ko": "참가자",
        "en": "Participants"
      },
      "icon": "users",
      "action": {
        "type": "hotkey",
        "keys": [
          "Alt",
          "U"
        ]
      }
    },
    "5": {
      "label": {
        "ko": "채팅",
        "en": "Chat"
      },
      "icon": "message-circle",
      "action": {
        "type": "hotkey",
        "keys": [
          "Alt",
          "H"
        ]
      }
    },
    "6": {
      "label": {
        "ko": "녹화",
        "en": "Record"
      },
      "icon": "circle-dot",
      "action": {
        "type": "hotkey",
        "keys": [
          "Alt",
          "R"
        ]
      }
    },
    "1": {
      "label": {
        "ko": "모든 마이크 끄기",
        "en": "Mute all mics"
      },
      "icon": "mic-off",
      "action": {
        "type": "micMute"
      }
    },
    "2": {
      "label": {
        "ko": "볼륨 -",
        "en": "Volume -"
      },
      "icon": "volume-1",
      "action": {
        "type": "media",
        "command": "volumeDown"
      }
    },
    "3": {
      "label": {
        "ko": "볼륨 +",
        "en": "Volume +"
      },
      "icon": "volume-2",
      "action": {
        "type": "media",
        "command": "volumeUp"
      }
    },
    "Enter": {
      "label": {
        "ko": "회의 나가기",
        "en": "Leave"
      },
      "icon": "log-out",
      "action": {
        "type": "hotkey",
        "keys": [
          "Alt",
          "Q"
        ]
      }
    },
    "0": {
      "label": {
        "ko": "화면 캡처",
        "en": "Screenshot"
      },
      "icon": "camera",
      "action": {
        "type": "hotkey",
        "keys": [
          "Win",
          "Shift",
          "S"
        ]
      }
    }
  }
}
