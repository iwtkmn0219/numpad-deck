        "9": { "label": "오른쪽 반", "action": { "type": "hotkey", "keys": ["Win", "Right"] } },
        "4": { "label": "이전 창", "action": { "type": "hotkey", "keys": ["Alt", "Tab"] } },
        "5": { "label": "최소화", "action": { "type": "hotkey", "keys": ["Win", "Down"] } },
        "6": { "label": "창 닫기", "action": { "type": "hotkey", "keys": ["Alt", "F4"] } },
        "1": { "label": "데스크톱 ←", "action": { "type": "hotkey", "keys": ["Ctrl", "Win", "Left"] } },
