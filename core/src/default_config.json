        "6": { "label": "볼륨 +", "action": { "type": "media", "command": "volumeUp" } },
        "1": { "label": "화면 캡처", "action": { "type": "hotkey", "keys": ["Win", "Shift", "S"] } },
        "2": { "label": "바탕화면", "action": { "type": "hotkey", "keys": ["Win", "D"] } },
        "3": { "label": "작업 관리자", "action": { "type": "hotkey", "keys": ["Ctrl", "Shift", "Esc"] } },
        "Enter": { "label": "탐색기", "action": { "type": "hotkey", "keys": ["Win", "E"] } }
