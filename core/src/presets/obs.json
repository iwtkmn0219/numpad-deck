{
  "name": {
    "ko": "방송(OBS)",
    "en": "Streaming (OBS)"
  },
  "description": {
    "ko": "장면 1–6, 녹화·방송 시작/중지. OBS 설정 → 단축키에서 각 항목 칸을 누른 뒤 이 페이지의 넘패드 버튼을 누르면 F13–F22가 지정돼요.",
    "en": "Scenes 1–6, start/stop recording and streaming. In OBS Settings → Hotkeys, click a field and press the numpad button here to assign F13–F22."
  },
  "buttons": {
    "7": {
      "label": {
        "ko": "장면 1",
        "en": "Scene 1"
      },
      "icon": "clapperboard",
      "action": {
        "type": "hotkey",
        "keys": [
          "F13"
        ]
      }
    },
    "8": {
      "label": {
        "ko": "장면 2",
        "en": "Scene 2"
      },
      "icon": "clapperboard",
